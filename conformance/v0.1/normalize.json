{
  "spec_version": "0.1",
  "suite": "normalize",
  "cases": [
    {
      "name": "collapse display whitespace",
      "operation": "text.display",
      "input": "  João\t da\nSilva  ",
      "output": "João da Silva"
    },
    {
      "name": "search text folds accents and punctuation",
      "operation": "text.search",
      "input": "  São-João / Nº 42  ",
      "output": "sao joao no 42"
    },
    {
      "name": "canonical email preserves local part and lowercases domain",
      "operation": "contact.email.canonicalize",
      "input": "User.Name@EXAMPLE.COM",
      "output": "User.Name@example.com"
    },
    {
      "name": "canonical CPF",
      "operation": "identity.br.cpf.canonicalize",
      "input": "529.982.247-25",
      "output": "52998224725"
    },
    {
      "name": "reject repeated CPF checksum",
      "operation": "identity.br.cpf.canonicalize",
      "input": "111.111.111-11",
      "error": "invalid_checksum"
    },
    {
      "name": "canonical numeric CNPJ",
      "operation": "identity.br.cnpj.canonicalize",
      "input": "11.222.333/0001-81",
      "output": "11222333000181"
    },
    {
      "name": "canonical alphanumeric CNPJ",
      "operation": "identity.br.cnpj.canonicalize",
      "input": "12.abc.345/01de-35",
      "output": "12ABC34501DE35"
    },
    {
      "name": "reject invalid CNPJ checksum",
      "operation": "identity.br.cnpj.canonicalize",
      "input": "00.000.000/0000-00",
      "error": "invalid_checksum"
    },
    {
      "name": "canonical Brazilian postal code",
      "operation": "postal.br.cep.canonicalize",
      "input": "90010-000",
      "output": "90010000"
    },
    {
      "name": "reject short Brazilian postal code",
      "operation": "postal.br.cep.canonicalize",
      "input": "90010-00",
      "error": "invalid_length"
    },
    {
      "name": "canonical Brazilian mobile phone",
      "operation": "contact.phone.br.canonicalize",
      "input": "(51) 99999-1234",
      "output": "+5551999991234"
    }
  ]
}
