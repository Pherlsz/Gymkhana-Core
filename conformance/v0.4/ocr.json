{
  "spec_version": "0.4",
  "suite": "ocr",
  "cases": [
    {
      "name": "validate schema guided extraction request",
      "operation": "ocr.request.validate",
      "input": {
        "mode": "schema_guided",
        "sources": [{"id": "document-1", "modality": "document", "media_type": "application/pdf"}],
        "target_schema": {
          "type": "object",
          "properties": {"name": {"type": "string"}},
          "required": ["name"],
          "additionalProperties": false
        },
        "max_candidates": 16
      },
      "output": true
    },
    {
      "name": "reject schema on discovery request",
      "operation": "ocr.request.validate",
      "input": {
        "mode": "discovery",
        "sources": [{"id": "image-1", "modality": "image"}],
        "target_schema": {"type": "object", "properties": {}, "required": [], "additionalProperties": false}
      },
      "error": "invalid_schema"
    },
    {
      "name": "discovery requires data identification skill",
      "operation": "ocr.required_skills",
      "input": {"mode": "discovery", "sources": [{"id": "image-1", "modality": "image"}]},
      "output": ["data_identification/v1"]
    },
    {
      "name": "schema guided extraction requires no discovery skill",
      "operation": "ocr.required_skills",
      "input": {
        "mode": "schema_guided",
        "sources": [{"id": "document-1", "modality": "document"}],
        "target_schema": {"type": "object", "properties": {}, "required": [], "additionalProperties": false}
      },
      "output": []
    },
    {
      "name": "canonical data identification skill",
      "operation": "ocr.skill.data_identification.builtin",
      "input": null,
      "output": {
        "id": "data_identification/v1",
        "policy": {
          "preserve_raw_observations": true,
          "require_evidence": true,
          "preserve_ambiguity": true,
          "do_not_invent_missing_values": true,
          "do_not_assume_jurisdiction": true,
          "normalize_only_with_explicit_canonicalizer": true
        }
      }
    },
    {
      "name": "validate evidence backed schema guided exchange",
      "operation": "ocr.exchange.validate",
      "input": {
        "request": {
          "mode": "schema_guided",
          "sources": [{"id": "document-1", "modality": "document"}],
          "target_schema": {
            "type": "object",
            "properties": {"name": {"type": "string"}},
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "result": {
          "mode": "schema_guided",
          "observations": [{
            "id": "obs-1",
            "evidence": [{"source_id": "document-1", "page": 1, "region": {"x": 100000, "y": 100000, "width": 400000, "height": 100000}}],
            "raw_text": "Alice",
            "confidence": 9800
          }],
          "candidates": [{
            "path": "/name",
            "state": "present",
            "value": "Alice",
            "observation_ids": ["obs-1"],
            "basis": "observed",
            "confidence": 9800,
            "validation": "valid",
            "review": "unreviewed"
          }],
          "structured_data": {"name": "Alice"},
          "validation": "valid",
          "review": "unreviewed"
        }
      },
      "output": true
    },
    {
      "name": "candidate value must match structured data",
      "operation": "ocr.exchange.validate",
      "input": {
        "request": {
          "mode": "schema_guided",
          "sources": [{"id": "document-1", "modality": "document"}],
          "target_schema": {
            "type": "object",
            "properties": {"name": {"type": "string"}},
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "result": {
          "mode": "schema_guided",
          "observations": [{"id": "obs-1", "evidence": [{"source_id": "document-1"}], "raw_text": "Alice"}],
          "candidates": [{"path": "/name", "state": "present", "value": "Bob", "observation_ids": ["obs-1"], "basis": "observed", "validation": "valid", "review": "unreviewed"}],
          "structured_data": {"name": "Alice"},
          "validation": "valid",
          "review": "unreviewed"
        }
      },
      "error": "invalid_candidate"
    },
    {
      "name": "mathematically equivalent decimals match candidate and structured data",
      "operation": "ocr.exchange.validate",
      "input": {
        "request": {
          "mode": "schema_guided",
          "sources": [{"id": "document-1", "modality": "document"}],
          "target_schema": {
            "type": "object",
            "properties": {"score": {"type": "number"}},
            "required": ["score"],
            "additionalProperties": false
          }
        },
        "result": {
          "mode": "schema_guided",
          "observations": [{"id": "obs-1", "evidence": [{"source_id": "document-1"}], "value": 1.0}],
          "candidates": [{"path": "/score", "state": "present", "value": 1.0, "observation_ids": ["obs-1"], "basis": "observed", "validation": "valid", "review": "unreviewed"}],
          "structured_data": {"score": 1},
          "validation": "valid",
          "review": "unreviewed"
        }
      },
      "output": true
    },
    {
      "name": "missing field remains distinct from JSON null",
      "operation": "ocr.result.validate",
      "input": {
        "mode": "discovery",
        "observations": [{"id": "obs-label", "evidence": [{"source_id": "image-1"}], "raw_text": "Passport number"}],
        "candidates": [{
          "path": "/passport_number",
          "state": "missing",
          "observation_ids": ["obs-label"],
          "basis": "observed",
          "semantic_type_candidates": ["identity.passport"],
          "validation": "not_validated",
          "review": "needs_review"
        }],
        "validation": "not_validated",
        "review": "needs_review"
      },
      "output": true
    },
    {
      "name": "reject JSON null payload on missing candidate",
      "operation": "ocr.result.validate",
      "input": {
        "mode": "discovery",
        "observations": [{"id": "obs-label", "evidence": [{"source_id": "image-1"}], "raw_text": "Passport number"}],
        "candidates": [{"path": "/passport_number", "state": "missing", "value": null, "observation_ids": ["obs-label"], "basis": "observed", "validation": "not_validated", "review": "needs_review"}],
        "validation": "not_validated",
        "review": "needs_review"
      },
      "error": "invalid_candidate"
    },
    {
      "name": "reject non document page evidence",
      "operation": "ocr.exchange.validate",
      "input": {
        "request": {"mode": "discovery", "sources": [{"id": "image-1", "modality": "image"}]},
        "result": {
          "mode": "discovery",
          "observations": [{"id": "obs-1", "evidence": [{"source_id": "image-1", "page": 1}], "raw_text": "text"}],
          "candidates": [],
          "validation": "not_validated",
          "review": "unreviewed"
        }
      },
      "error": "invalid_evidence"
    },
    {
      "name": "reject unknown evidence source",
      "operation": "ocr.exchange.validate",
      "input": {
        "request": {"mode": "discovery", "sources": [{"id": "image-1", "modality": "image"}]},
        "result": {
          "mode": "discovery",
          "observations": [{"id": "obs-1", "evidence": [{"source_id": "other-image"}], "raw_text": "text"}],
          "candidates": [],
          "validation": "not_validated",
          "review": "unreviewed"
        }
      },
      "error": "unknown_source"
    },
    {
      "name": "reject confidence outside portable scale",
      "operation": "ocr.result.validate",
      "input": {
        "mode": "discovery",
        "observations": [{"id": "obs-1", "evidence": [{"source_id": "image-1"}], "raw_text": "text", "confidence": 10001}],
        "candidates": [],
        "validation": "not_validated",
        "review": "unreviewed"
      },
      "error": "invalid_confidence"
    },
    {
      "name": "normalization requires explicit canonicalizer",
      "operation": "ocr.result.validate",
      "input": {
        "mode": "discovery",
        "observations": [{"id": "obs-1", "evidence": [{"source_id": "image-1"}], "raw_text": "  Alice  "}],
        "candidates": [{"path": "/name", "state": "present", "value": "  Alice  ", "normalized_value": "Alice", "observation_ids": ["obs-1"], "basis": "derived", "validation": "not_validated", "review": "unreviewed"}],
        "validation": "not_validated",
        "review": "unreviewed"
      },
      "error": "invalid_candidate"
    }
  ]
}
