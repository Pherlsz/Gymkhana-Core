    {
      "name": "sha256 empty text",
      "operation": "fingerprint.sha256.text",
      "input": "",
      "output": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    },
    {
      "name": "sha256 UTF-8 text",
      "operation": "fingerprint.sha256.text",
      "input": "João",
      "output": "9c48393460d7a004f5d12abed54f76afcb21c0a18a5c22e48f44b2b14acb2f9d"
    },
    {
      "name": "framed text portable vector",
      "operation": "fingerprint.sha256.framed_text",
      "input": {"namespace": "query.plan/v1", "parts": ["alpha", "beta"]},
      "output": "8f92cbf0d8c72b614311eadbf43c8842fc53e77f5a3943448db7a1f12ea470fd"
    },
    {
      "name": "framed UTF-8 text",
      "operation": "fingerprint.sha256.framed_text",
