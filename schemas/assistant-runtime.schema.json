{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pherlsz/Gymkhana-Core/schemas/assistant-runtime.schema.json",
  "title": "Gymkhana Core Assistant runtime contracts",
  "$defs": {
    "RunOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable_modules": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "assistant-config.schema.json#/$defs/ModuleID"}},
        "disable_modules": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "assistant-config.schema.json#/$defs/ModuleID"}},
        "model": {"$ref": "assistant-config.schema.json#/$defs/ModelRef"},
        "credentials": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "assistant-config.schema.json#/$defs/CredentialRef"},
          "description": "Caller order is significant. Multiple logical credentials for the same provider form an ordered fallback chain."
        },
        "credential_fallback": {"$ref": "assistant-config.schema.json#/$defs/CredentialFallbackPolicy"},
        "routing_fallback": {"$ref": "assistant-config.schema.json#/$defs/RoutingFallbackPolicy"}
      }
    },
    "ProviderDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "credential_modes"],
      "properties": {
        "id": {"$ref": "assistant-config.schema.json#/$defs/ProviderID"},
        "display_name": {"type": "string", "maxLength": 256},
        "credential_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "assistant-config.schema.json#/$defs/CredentialMode"}
        }
      }
    },
    "GenerationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "messages"],
      "properties": {
        "model": {"$ref": "assistant-config.schema.json#/$defs/ModelRef"},
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {"$ref": "assistant.schema.json#/$defs/Message"},
          "description": "Cross-message tool-call/result linkage is enforced semantically."
        },
        "tools": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "assistant.schema.json#/$defs/ToolDefinition"}
        },
        "response_schema": {
          "type": "object",
          "description": "Must satisfy portable_json_schema/v1 semantic validation."
        },
        "credential": {"$ref": "assistant-config.schema.json#/$defs/CredentialRef"}
      }
    },
    "GenerationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "message", "finish_reason"],
      "properties": {
        "model": {"$ref": "assistant-config.schema.json#/$defs/ModelRef"},
        "message": {"$ref": "assistant.schema.json#/$defs/Message"},
        "finish_reason": {"$ref": "assistant.schema.json#/$defs/FinishReason"},
        "usage": {"$ref": "assistant.schema.json#/$defs/Usage"}
      },
      "description": "Model provider, tool allowlist and finish/tool-call relationships are enforced by ValidateGenerationExchange/equivalent."
    }
  }
}
