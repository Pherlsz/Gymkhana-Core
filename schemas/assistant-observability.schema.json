{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pherlsz/Gymkhana-Core/schemas/assistant-observability.schema.json",
  "title": "Gymkhana Core Assistant observability and learning",
  "$defs": {
    "QuotaDimension": {"type": "string", "enum": ["requests", "input_tokens", "output_tokens", "total_tokens"]},
    "QuotaWindow": {
      "type": "object", "additionalProperties": false, "required": ["dimension"],
      "properties": {
        "dimension": {"$ref": "#/$defs/QuotaDimension"},
        "limit": {"$ref": "assistant-config.schema.json#/$defs/SafeInteger"},
        "used": {"$ref": "assistant-config.schema.json#/$defs/SafeInteger"},
        "remaining": {"$ref": "assistant-config.schema.json#/$defs/SafeInteger"},
        "window_seconds": {"$ref": "assistant-config.schema.json#/$defs/SafeInteger"},
        "reset_at_unix": {"$ref": "assistant-config.schema.json#/$defs/SafeInteger"}
      }
    },
    "QuotaState": {
      "type": "object", "additionalProperties": false, "required": ["provider", "known"],
      "properties": {
        "provider": {"$ref": "assistant-config.schema.json#/$defs/ProviderID"},
        "credential": {"$ref": "assistant-config.schema.json#/$defs/CredentialIdentity"},
        "model": {"$ref": "assistant-config.schema.json#/$defs/ModelRef"},
        "known": {"type": "boolean"},
        "limits": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/QuotaWindow"}}
      },
      "description": "Quota belongs to the provider/account/project scope actually reported. It is not implicitly per Assistant or per API key."
    },
    "UsageLedgerEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "attempt", "assistant_id", "model", "usage"],
      "properties": {
        "run_id": {"$ref": "assistant-config.schema.json#/$defs/OpaqueRef"},
        "attempt": {"$ref": "assistant-config.schema.json#/$defs/SafeInteger"},
        "assistant_id": {"$ref": "assistant-config.schema.json#/$defs/PortableID"},
        "credential": {"$ref": "assistant-config.schema.json#/$defs/CredentialIdentity"},
        "model": {"$ref": "assistant-config.schema.json#/$defs/ModelRef"},
        "usage": {"$ref": "assistant.schema.json#/$defs/Usage"},
        "observed_at_unix": {"$ref": "assistant-config.schema.json#/$defs/SafeInteger"}
      }
    },
    "AttemptTrace": {
      "type": "object", "additionalProperties": false, "required": ["index", "model"],
      "properties": {
        "index": {"$ref": "assistant-config.schema.json#/$defs/SafeInteger"},
        "model": {"$ref": "assistant-config.schema.json#/$defs/ModelRef"},
        "credential": {"$ref": "assistant-config.schema.json#/$defs/CredentialIdentity"},
        "failure": {"$ref": "assistant-config.schema.json#/$defs/FailureClass"},
        "usage": {"$ref": "assistant.schema.json#/$defs/Usage"},
        "duration_millis": {"$ref": "assistant-config.schema.json#/$defs/SafeInteger"}
      }
    },
    "RunTrace": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "assistant_id", "effective_modules"],
      "properties": {
        "run_id": {"$ref": "assistant-config.schema.json#/$defs/OpaqueRef"},
        "assistant_id": {"$ref": "assistant-config.schema.json#/$defs/PortableID"},
        "assistant_revision": {"$ref": "assistant-config.schema.json#/$defs/SafeInteger"},
        "effective_modules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "assistant-config.schema.json#/$defs/ModuleID"}},
        "attempts": {"type": "array", "items": {"$ref": "#/$defs/AttemptTrace"}},
        "retrieval_rounds": {"$ref": "assistant-config.schema.json#/$defs/SafeInteger"},
        "tool_calls": {"$ref": "assistant-config.schema.json#/$defs/SafeInteger"},
        "started_at_unix": {"$ref": "assistant-config.schema.json#/$defs/SafeInteger"},
        "duration_millis": {"$ref": "assistant-config.schema.json#/$defs/SafeInteger"},
        "finish_reason": {"$ref": "assistant.schema.json#/$defs/FinishReason"}
      },
      "description": "Trace deliberately carries no prompt, tool payload, media URI, provider error body or secret-store reference."
    },
    "TaskSignature": {
      "type": "object", "additionalProperties": false, "required": ["family", "version"],
      "properties": {
        "family": {"$ref": "assistant-config.schema.json#/$defs/PortableID"},
        "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "traits": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "assistant-config.schema.json#/$defs/PortableID"}}
      },
      "description": "Traits must be sorted in canonical lexical order by semantic validation."
    },
    "LearningEvidence": {
      "type": "object", "additionalProperties": false, "required": ["run_id", "outcome", "origin"],
      "properties": {
        "run_id": {"$ref": "assistant-config.schema.json#/$defs/OpaqueRef"},
        "outcome": {"enum": ["success", "failure", "improved", "regressed"]},
        "origin": {"enum": ["runtime", "evaluation", "human"]},
        "failure_class": {"$ref": "assistant-config.schema.json#/$defs/FailureClass"}
      }
    },
    "SkillLearningProposal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "assistant_id", "task", "scope", "summary", "revision", "evidence"],
      "properties": {
        "id": {"$ref": "assistant-config.schema.json#/$defs/PortableID"},
        "assistant_id": {"$ref": "assistant-config.schema.json#/$defs/PortableID"},
        "task": {"$ref": "#/$defs/TaskSignature"},
        "scope": {"$ref": "assistant-config.schema.json#/$defs/LearningScope"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/LearningEvidence"}}
      },
      "description": "Summary is advisory untrusted data. Core never automatically promotes it to system/developer instruction authority."
    }
  }
}
